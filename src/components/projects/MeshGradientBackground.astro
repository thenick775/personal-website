---
interface Props {
  colors?: string[];
  speed?: number;
  backgroundColor?: string;
}

const {
  colors = ["#7c3aed", "#2563eb", "#06b6d4", "#8b5cf6"],
  speed = 1,
  backgroundColor = "#030014",
} = Astro.props;

const safeSpeed = Number.isFinite(speed) && speed > 0 ? speed : 1;
const duration1 = `${60 / safeSpeed}s`;
const duration2 = `${80 / safeSpeed}s`;
const duration3 = `${90 / safeSpeed}s`;
const duration4 = `${70 / safeSpeed}s`;

const [color1, color2, color3, color4 = colors[0] ?? "#7c3aed"] = colors;
---

<div
  class="project-mesh-gradient"
  style={`background-color: ${backgroundColor};`}
  aria-hidden="true"
>
  <div class="project-mesh-gradient-orbs">
    <div
      class="project-mesh-gradient-orb project-mesh-gradient-orb-one"
      style={`background: radial-gradient(circle, ${color1}40 0%, transparent 70%); animation-duration: ${duration1};`}
    >
    </div>

    <div
      class="project-mesh-gradient-orb project-mesh-gradient-orb-two"
      style={`background: radial-gradient(circle, ${color2}35 0%, transparent 70%); animation-duration: ${duration2};`}
    >
    </div>

    <div
      class="project-mesh-gradient-orb project-mesh-gradient-orb-three"
      style={`background: radial-gradient(circle, ${color3}30 0%, transparent 70%); animation-duration: ${duration3};`}
    >
    </div>

    <div
      class="project-mesh-gradient-orb project-mesh-gradient-orb-four"
      style={`background: radial-gradient(circle, ${color4}25 0%, transparent 70%); animation-duration: ${duration4};`}
    >
    </div>
  </div>

  <div class="project-mesh-gradient-noise"></div>
</div>

<style>
  .project-mesh-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .project-mesh-gradient-orbs {
    position: absolute;
    inset: 0;
  }

  .project-mesh-gradient-orb {
    position: absolute;
    border-radius: 999px;
    will-change: transform;
  }

  .project-mesh-gradient-orb-one {
    top: -10%;
    left: -10%;
    width: 60%;
    height: 60%;
    filter: blur(80px);
    animation: mesh-gradient-move-1 ease-in-out infinite;
  }

  .project-mesh-gradient-orb-two {
    top: 10%;
    right: -5%;
    width: 50%;
    height: 50%;
    filter: blur(100px);
    animation: mesh-gradient-move-2 ease-in-out infinite;
  }

  .project-mesh-gradient-orb-three {
    bottom: -15%;
    left: 20%;
    width: 70%;
    height: 55%;
    filter: blur(120px);
    animation: mesh-gradient-move-3 ease-in-out infinite;
  }

  .project-mesh-gradient-orb-four {
    top: 30%;
    left: 40%;
    width: 40%;
    height: 40%;
    filter: blur(90px);
    animation: mesh-gradient-move-4 ease-in-out infinite;
  }

  .project-mesh-gradient-noise {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  @keyframes mesh-gradient-move-1 {
    0%,
    100% {
      transform: translate(0%, 0%) scale(1);
    }

    25% {
      transform: translate(5%, 10%) scale(1.05);
    }

    50% {
      transform: translate(10%, 5%) scale(0.95);
    }

    75% {
      transform: translate(5%, -5%) scale(1.02);
    }
  }

  @keyframes mesh-gradient-move-2 {
    0%,
    100% {
      transform: translate(0%, 0%) scale(1);
    }

    33% {
      transform: translate(-10%, 8%) scale(1.08);
    }

    66% {
      transform: translate(-5%, -5%) scale(0.95);
    }
  }

  @keyframes mesh-gradient-move-3 {
    0%,
    100% {
      transform: translate(0%, 0%) scale(1);
    }

    50% {
      transform: translate(-8%, -10%) scale(1.1);
    }
  }

  @keyframes mesh-gradient-move-4 {
    0%,
    100% {
      transform: translate(0%, 0%) scale(1);
    }

    25% {
      transform: translate(15%, -10%) scale(0.9);
    }

    50% {
      transform: translate(-10%, 15%) scale(1.1);
    }

    75% {
      transform: translate(-15%, -5%) scale(0.95);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-mesh-gradient-orb {
      animation: none;
    }
  }
</style>
